# Copy to Vercel Environment Variables (Project → Settings → Environment Variables)

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# Neon Postgres (free): https://neon.tech — paste connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Cloudinary (optional): https://cloudinary.com — only if you prefer CDN storage over Django DB media
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Admin login (run once after deploy: vercel env pull && python manage.py setup_admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional custom domain
# ALLOWED_HOSTS=yourdomain.com,.vercel.app
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://your-app.vercel.app
